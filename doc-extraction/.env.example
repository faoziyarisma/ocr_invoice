# Provider LLM: "mock" (default, gratis, jalan offline via regex) atau "openai_compatible"
# (Google AI Studio, OpenRouter, Ollama lokal, OpenAI asli — endpoint apapun yang
# kompatibel dengan format Chat Completions OpenAI).
LLM_PROVIDER=mock

# Contoh untuk Google AI Studio (gratis, ada vision):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-google-ai-studio-key
# LLM_MODEL=gemini-1.5-flash

# Contoh untuk OpenRouter (free models):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Contoh untuk Ollama lokal:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Estimasi harga per 1K token, untuk menghitung cost_usd (sesuaikan dgn provider asli)
PRICE_IN_PER_1K=0.00015
PRICE_OUT_PER_1K=0.0006
